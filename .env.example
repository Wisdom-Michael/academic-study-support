# Copy this file to .env (in this same folder) and fill in your values.
# The server reads it on startup. Never commit the real .env file.

# --- Data tier: MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=academic_support_db

# Hosted MySQL (e.g. Aiven) instead of the DB_* lines above:
# DATABASE_URL=mysql://user:password@host:port/defaultdb
# DB_SSL_CA=<the provider's CA certificate, PEM text>

# An empty database is set up with the demo data on first start (set to false to turn off)
SEED_ON_EMPTY=true
# Optional: password for every demo account when seeding, instead of Study@2026
DEMO_PASSWORD=

# --- Middle tier: Express API server ---
PORT=4000
# The React dev server's address, allowed through CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Use a long random string, for example the
# output of:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Claude API key, used to write concept checks from uploaded materials.
# Create one at https://platform.claude.com/settings/keys. Leave blank to turn generation off.
ANTHROPIC_API_KEY=

# Optional: only allow registration with this email domain (e.g. university.edu).
# Leave blank to allow any email address.
INSTITUTION_EMAIL_DOMAIN=
